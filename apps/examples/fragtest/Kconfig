#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config EXAMPLES_FRAGTEST
	tristate "Memory fragmentation testing"
	default n
	---help---
		Enable the fragtest example

if EXAMPLES_FRAGTEST

config EXAMPLES_FRAGTEST_PROGNAME
	string "Program name"
	default "fragtest"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config EXAMPLES_FRAGTEST_PRIORITY
	int "Fragtest task priority"
	default 100

config EXAMPLES_FRAGTEST_STACKSIZE
	int "Fragtest stack size"
	default DEFAULT_TASK_STACKSIZE

endif
